# GW Project Backend Configuration (Template - configure in private backend/.env)
PORT=8080
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_strong_database_password
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=3000
JWT_SECRET=generate_a_secure_random_64_character_secret_here
JWT_EXPIRATION=7d
# Comma-separated list of allowed CORS origins (leave empty for wildcard in dev)
CORS_ORIGINS=
