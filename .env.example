# ==============================================================================
# SPENDWISE (PFIS) - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# NEVER commit .env with real secrets to version control!
# ==============================================================================

# Current environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Enforce strict HTTPS in production (default: false for self-hosted, true for strict SSL)
ENFORCE_HTTPS=false

# Core Backend API Base URL
API_BASE_URL=http://xqeqm4yyv7fqxryrkm6phk55.163.227.239.97.sslip.io/api/v1

# API Network timeout in seconds
API_TIMEOUT_SECONDS=30

# CDN / Sample Asset Endpoints
SAMPLE_AVATAR_URL=https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400

# ==============================================================================
# REST API ENDPOINTS (Zero hardcoded endpoints in source code)
# ==============================================================================

# System Health & Diagnostics
API_ENDPOINT_HEALTH=/health

# Authentication & Session
API_ENDPOINT_AUTH_LOGIN=/auth/login
API_ENDPOINT_AUTH_REGISTER=/auth/register
API_ENDPOINT_AUTH_ME=/auth/me
API_ENDPOINT_AUTH_REFRESH=/auth/refresh
API_ENDPOINT_AUTH_LOGOUT=/auth/logout
API_ENDPOINT_AUTH_PROFILE=/auth/profile
API_ENDPOINT_AUTH_FORGOT_PASSWORD=/auth/forgot-password
API_ENDPOINT_AUTH_RESET_PASSWORD=/auth/reset-password

# Projects & Financials
API_ENDPOINT_PROJECTS=/projects
API_ENDPOINT_PROJECT_COST_BREAKDOWN=/projects/financials/cost-breakdown

# Expenses & Receipts
API_ENDPOINT_EXPENSES=/expenses
API_ENDPOINT_EXPENSES_SUBMIT=/expenses/submit
API_ENDPOINT_EXPENSES_COMPLIANCE=/expenses/compliance

# Categories & Policy Caps
API_ENDPOINT_CATEGORIES=/categories

# Clients & Corporate Cost Center
API_ENDPOINT_CLIENTS=/clients

# Tasks & Team Allocations
API_ENDPOINT_TASKS=/tasks

# User Management & RBAC
API_ENDPOINT_USERS=/users

# Audit Logs (Tamper-evident trail)
API_ENDPOINT_AUDIT_LOGS=/audit-logs

# Notifications
API_ENDPOINT_NOTIFICATIONS=/notifications

# Reports & Analytics
API_ENDPOINT_REPORTS_SUMMARY=/reports/summary
API_ENDPOINT_REPORTS_EXPORT=/reports/export
API_ENDPOINT_REPORTS_FINANCIAL_SUMMARY=/reports/financial-summary
API_ENDPOINT_REPORTS_RECEIPT_COMPLIANCE=/reports/receipt-compliance

# Historical Estimator & Benchmarks
API_ENDPOINT_COST_ESTIMATOR=/admin/cost-estimator/historical
API_ENDPOINT_BENCHMARKS=/estimator/benchmarks
