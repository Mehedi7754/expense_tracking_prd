# ==============================================================================
# SPENDWISE (PFIS) - SECURE ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# CRITICAL SECURITY POLICY:
# - NEVER commit real secrets, passwords, or live hostnames/IPs to version control.
# - The actual .env file and all .env.* variants are strictly ignored by .gitignore.
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT=production

# Enforce strict HTTPS in production (default: true for enterprise security)
ENFORCE_HTTPS=true

# Core Backend API Base URL (Generic placeholder - configure in private .env)
API_BASE_URL=https://api.yourcompany.com/api/v1

# Network request timeout in seconds
API_TIMEOUT_SECONDS=30

# Optional CDN asset fallback
SAMPLE_AVATAR_URL=https://cdn.yourcompany.com/assets/default-avatar.png
