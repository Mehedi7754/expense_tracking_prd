# ==============================================================================
# SPENDWISE (PFIS) - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# NEVER commit .env with real secrets to version control!
# ==============================================================================

# Current environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Core Backend API Base URL
API_BASE_URL=https://api.example.com/api/v1

# API Network timeout in seconds
API_TIMEOUT_SECONDS=30

# CDN / Sample Asset Endpoints
SAMPLE_AVATAR_URL=https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400
